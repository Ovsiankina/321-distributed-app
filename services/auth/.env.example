# Copier en .env, ignoré par git : cp .env.example .env

# Mot de passe de auth-db. Tous les caractères sont permis : il n'est pas recopié dans l'URL.
AUTH_DB_PASSWORD=change-moi

# Clé privée Ed25519 : coller le contenu complet du fichier PEM entre guillemets doubles
# (voir README, « Clé de signature »).
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
à remplacer
-----END PRIVATE KEY-----"
